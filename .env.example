DATASET_PATH=.\data\raw\ecommerce_sales_raw.csv.csv
APP_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=demo@example.com
ADMIN_PASSWORD=demo-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_intelligence
DB_CHARSET=utf8mb4

# Optional: Real Mobile SMS Gateways (for live SMS delivery to physical phones)
# Fast2SMS (Free / Instant SMS for Indian mobile numbers like 6363276441): https://www.fast2sms.com
FAST2SMS_API_KEY=
# Twilio (Global SMS Gateway): https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Firebase Admin SDK Service Account (for Firebase Phone OTP verification)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Place the JSON file in the project root folder (e.g., firebase-adminsdk-<PROJECT_ID>-<hash>.json).
# If the file is named firebase-adminsdk-*.json in the project root, the backend auto-discovers it.
# Otherwise set GOOGLE_APPLICATION_CREDENTIALS to the absolute or relative path of the JSON file.
# Firebase Web SDK config (Paste these in .env.local for the Vite frontend, prefixed with VITE_):
#   VITE_FIREBASE_apiKey=xxx
#   VITE_FIREBASE_authDomain=xxx.firebaseapp.com
#   VITE_FIREBASE_projectId=xxx
#   VITE_FIREBASE_storageBucket=xxx.appspot.com
#   VITE_FIREBASE_messagingSenderId=xxx
#   VITE_FIREBASE_appId=1:xxx:web:xxx
GOOGLE_APPLICATION_CREDENTIALS=
